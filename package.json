{
  "name": "dsh-skill-mini-manager",
  "description": "Minimal skill manager for DSH Web: a Settings page beside Plugins that lists every installed skill with its summary, source and size, and removes any of them (recoverable trash). skill极简管理：与「插件」同级的一页，列出全部 skill 及简介并可逐个移除。",
  "version": "2.0.3",
  "type": "module",
  "main": "lib/index.js",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "skills",
    "skill-manager",
    "skill-mini-manager"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runcat-tommy/dsh-skill-mini-manager.git"
  },
  "homepage": "https://github.com/runcat-tommy/dsh-skill-mini-manager#readme",
  "bugs": {
    "url": "https://github.com/runcat-tommy/dsh-skill-mini-manager/issues"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./catalog": {
      "default": "./lib/catalog.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "marketplace": {
      "profiles": ["web"],
      "requiresBuildApproval": false,
      "requiresRestart": true,
      "manualSteps": false
    }
  },
  "files": [
    "cordis.patch.yml",
    "lib",
    "assets",
    "screenshots.json",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6 || ^0.2.0-rc.1"
  }
}
